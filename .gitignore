# Ignore everything at the top level except sbx, .githooks, and this file
/*
!/sbx/
!/.gitignore
!/.githooks/

# Understand-Anything scratch output (the knowledge graph itself is committed)
.ua/intermediate/
.ua/diff-overlay.json
.ua/.trash-*/

# Local SQLite databases (e.g. dev-state.db built from sbx/db/seed.sql)
*.db
*.db-wal
*.db-shm
.env
__pycache__
.venv
.DS_Store
1G-SETUP-README.md

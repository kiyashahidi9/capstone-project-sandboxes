# Copy to .env and fill in. The API server, the SDK and agents load it automatically.

# required on the host and on your computer: the key for every API request; use the same value in both.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SANDBOX_ADMIN_KEY=

# required on the host: OpenAI key, passed to the agent on each turn
OPENAI_API_KEY=

# optional: where the SDK finds the sandbox API on the GCP VM.
# The API binds to 127.0.0.1 on the VM, so reach it through an SSH tunnel:
#   gcloud compute ssh sbx-node-1 --zone=us-east1-b -- -N -L 8000:localhost:8000
SANDBOX_API=http://localhost:8000

# required on the host: the agent the runner starts for each message (docs/agent_contract.md).
# scripts/setup_agents.sh installs it in /opt/agents, where the locked-down agent can read it.
AGENT_CMD=/opt/agents/.venv/bin/python /opt/agents/agent.py

# optional: seconds a turn may run before the runner kills it (default 30 minutes)
AGENT_TURN_TIMEOUT=1800

# development only: runs the agent without systemd-run, as the API's own user (root).
# Never set it on a host with real clients.
# AGENT_ISOLATION=none

# Copy to .env and fill in. The SDK, mock API and agent load it automatically.

# required: OpenAI key for example_agent/agent_openai.py
OPENAI_API_KEY=

# optional: where the SDK finds the sandbox API (the mock locally, the real API on the host later)
SANDBOX_API=http://localhost:8000

# optional: where the mock API finds the guest agent
GUEST_AGENT=http://127.0.0.1:49983

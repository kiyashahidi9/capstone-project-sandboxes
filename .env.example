# Copy to .env and fill in. The SDK and agents load it automatically.

# required: OpenAI key for example_agent/agent_openai.py
OPENAI_API_KEY=

# optional: where the SDK finds the sandbox API on the GCP VM.
# The API binds to 127.0.0.1 on the VM, so reach it through an SSH tunnel:
#   gcloud compute ssh sbx-node-1 --zone=us-east1-b -- -N -L 8000:localhost:8000
SANDBOX_API=http://localhost:8000
